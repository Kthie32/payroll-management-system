# App database user (SELECT/INSERT/UPDATE/DELETE only) — used by the running app.
DATABASE_URL="mysql://payroll_app:change-me-app@127.0.0.1:3307/payroll"
# Migration user (DDL rights) — used by prisma migrate / seed / reset.
MIGRATE_DATABASE_URL="mysql://payroll_migrator:change-me-migrator@127.0.0.1:3307/payroll"
# Shadow DB for `prisma migrate dev`.
SHADOW_DATABASE_URL="mysql://payroll_migrator:change-me-migrator@127.0.0.1:3307/payroll_shadow"
# Integration tests (reset before each run).
TEST_DATABASE_URL="mysql://payroll_migrator:change-me-migrator@127.0.0.1:3307/payroll_test"

# Auth.js secret: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# 32-byte key, base64: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
FIELD_ENCRYPTION_KEY=""

SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"

# ── Payslip delivery (email + SMS) ──────────────────────────────────────────
# outbox (default): nothing is sent; messages are stored at /admin/messages for review.
# live: email through SMTP and SMS through Africa's Talking (each channel needs its settings).
MESSAGING_MODE="outbox"
# Public address of this app, used in payslip links (e.g. https://payroll.mageziharvest.co.ug).
APP_BASE_URL="http://localhost:3000"
# Days a payslip link stays valid (max 90).
PAYSLIP_LINK_DAYS=7
# SMTP (port 465 = TLS, 587 = STARTTLS).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Magezi Harvest Payroll <payroll@example.com>"
# Africa's Talking SMS. Use AT_USERNAME="sandbox" for their test environment.
AT_USERNAME=""
AT_API_KEY=""
AT_SENDER_ID=""
