# App database user (SELECT/INSERT/UPDATE/DELETE only) — used by the running app.
DATABASE_URL="mysql://payroll_app:change-me-app@localhost:3306/payroll"
# Migration user (DDL rights) — used by prisma migrate / seed / reset.
MIGRATE_DATABASE_URL="mysql://payroll_migrator:change-me-migrator@localhost:3306/payroll"
# Shadow DB for `prisma migrate dev`.
SHADOW_DATABASE_URL="mysql://payroll_migrator:change-me-migrator@localhost:3306/payroll_shadow"
# Integration tests (reset before each run).
TEST_DATABASE_URL="mysql://payroll_migrator:change-me-migrator@localhost:3306/payroll_test"

# Auth.js secret: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# 32-byte key, base64: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
FIELD_ENCRYPTION_KEY=""

SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
